{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprint Kit",
  "version": "0.5.0",
  "identifier": "com.sprintkit.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sprint Kit for Trello",
        "width": 900,
        "height": 820,
        "minWidth": 520,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NTc2RjE4RTA2NzA0QjkKUldTNUJHZmdHRzlYeFZONkYvUGg1Q2VoT1hLTzE0U0RRZVRwdW1URlFJUWh1d1lXWHByc3BSU0MK",
      "endpoints": [
        "https://github.com/Boci0/sprint-kit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
