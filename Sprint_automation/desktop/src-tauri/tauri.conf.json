{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprint Kit",
  "version": "0.1.2",
  "identifier": "com.sprintkit.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sprint Kit for Trello",
        "width": 900,
        "height": 820,
        "minWidth": 520,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
